{
	"name": "newfolio",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"prepare": "husky",
		"test": "vitest"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,css,scss}": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"dependencies": {
		"@million/lint": "^1.0.0-rc.84",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"use-signals": "^0.1.1"
	},
	"devDependencies": {
		"@biomejs/biome": "1.8.3",
		"@testing-library/jest-dom": "^6.4.8",
		"@testing-library/react": "^16.0.0",
		"@types/bun": "^1.1.6",
		"@types/node": "^22.0.0",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^4.3.1",
		"husky": "^9.1.4",
		"jsdom": "^24.1.1",
		"lint-staged": "^15.2.7",
		"typescript": "^5.2.2",
		"vite": "^5.3.4",
		"vitest": "^2.0.4"
	}
}
